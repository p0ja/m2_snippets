<?php
/**
 * Changed: lists the items read by M2\CRUD\Block\Main. Every value is escaped with $escaper, which Magento 2.4
 * passes to each template, instead of dumping raw rows with var_dump().
 *
 * @var \M2\CRUD\Block\Main $block
 * @var \Magento\Framework\Escaper $escaper
 */
?>
<h1><?= $escaper->escapeHtml(__('Items')) ?></h1>
<ul>
    <?php foreach ($block->getItems() as $item): ?>
        <li>
            <?= $escaper->escapeHtml($item->getData('item_sku')) ?>
            &ndash; <?= $escaper->escapeHtml($item->getData('item_title')) ?>
        </li>
    <?php endforeach; ?>
</ul>
