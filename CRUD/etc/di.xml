<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Service contracts: classes depend on the interfaces, these preferences choose the implementations -->
    <preference for="M2\CRUD\Api\ItemRepositoryInterface" type="M2\CRUD\Model\ItemRepository"/>
    <preference for="M2\CRUD\Api\Data\ItemInterface" type="M2\CRUD\Model\Item"/>
    <preference for="M2\CRUD\Api\Data\ItemSearchResultsInterface" type="Magento\Framework\Api\SearchResults"/>
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="m2_crud_command_examples" xsi:type="object">M2\CRUD\Command\ListSku</item>
            </argument>
        </arguments>
    </type>
</config>
