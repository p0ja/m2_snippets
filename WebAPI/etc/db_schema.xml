<?xml version="1.0"?>
<!--
    Declarative schema instead of Setup/InstallSchema.php and Setup/InstallData.php (deprecated since 2.3).
    Core tables can be extended the same way: the sales_order and sales_order_grid entries only add a column.
-->
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="vendor_order_erp_status" resource="sales" engine="innodb" comment="Order ERP Synchronization Status">
        <column xsi:type="int" name="id" unsigned="true" nullable="false" identity="true" comment="ID"/>
        <column xsi:type="varchar" name="increment_id" nullable="false" length="32" comment="Order Increment ID"/>
        <column xsi:type="varchar" name="erp_order_id" nullable="false" length="32" comment="ERP Order ID"/>
        <column xsi:type="varchar" name="status" nullable="false" length="32" comment="Status"/>
        <column xsi:type="text" name="description" nullable="true" comment="Description"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
        <index referenceId="VENDOR_ORDER_ERP_STATUS_INCREMENT_ID" indexType="btree">
            <column name="increment_id"/>
        </index>
    </table>
    <table name="sales_order" resource="sales">
        <column xsi:type="varchar" name="current_erp_status" nullable="true" length="32" comment="Current ERP Status"/>
    </table>
    <table name="sales_order_grid" resource="sales">
        <column xsi:type="varchar" name="current_erp_status" nullable="true" length="32" comment="Current ERP Status"/>
        <index referenceId="SALES_ORDER_GRID_CURRENT_ERP_STATUS" indexType="btree">
            <column name="current_erp_status"/>
        </index>
    </table>
</schema>
