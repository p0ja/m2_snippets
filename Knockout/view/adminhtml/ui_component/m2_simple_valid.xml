<?xml version="1.0"?>
<!--
    Changed: rewritten to the <settings> syntax (Magento 2.2+) validated by ui_configuration.xsd. The data source
    has an <aclResource> like the page controller.
-->
<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd"
           template="templates/m2_simple_valid/default">
    <dataSource name="m2_simple_valid_data_source">
        <aclResource>M2_Knockout::menu_1</aclResource>
        <!-- the PHP class that implements the data provider; name repeats the dataSource name -->
        <dataProvider class="M2\Knockout\Model\DataProvider" name="m2_simple_valid_data_source">
            <settings>
                <!-- UI components are meant to work with URL parameters -->
                <requestFieldName>id</requestFieldName>
                <!-- UI components are meant to work with models -->
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <!--<htmlContent name="first_content">
        <block class="M2\Knockout\Block\Adminhtml\Example" name="m2_knockout_example"/>
    </htmlContent> -->
    <htmlContent name="second_content" class="M2\Knockout\Ui\Component\Simple"
                 component="M2_Knockout/js/m2_simple_component"/>
</container>
