<?xml version="1.0"?>
<!--
    Changed: the references are inside <body> as page_configuration.xsd requires; the block is the generic backend
    template block (M2\Knockout\Block\Adminhtml\Main was an empty class); the UI component name is lowercase like
    its file, "M2_simple_valid" was not found on case-sensitive file systems.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magento\Backend\Block\Template" name="m2_knockout_block_main"
                   template="M2_Knockout::content.phtml"/>
            <uiComponent name="m2_simple_valid"/>
        </referenceContainer>
    </body>
</page>
