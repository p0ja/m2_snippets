<?xml version="1.0"?>
<!--
    Changed: the reference is inside <body> as page_configuration.xsd requires, and the block is the generic
    template block (M2\Knockout\Block\Main was an empty class).
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="m2_knockout_block_main"
                   template="M2_Knockout::content.phtml"/>
        </referenceContainer>
    </body>
</page>
