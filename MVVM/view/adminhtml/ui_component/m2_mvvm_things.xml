<?xml version="1.0"?>
<!--
    Changed: rewritten from nested <argument>/<item> arrays to the <settings> syntax (Magento 2.2+), which the
    ui_configuration.xsd validates. <aclResource> protects the mui/index/render requests that load the rows.
    The "Add New" URL uses the lowercase controller path.
-->
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">m2_mvvm_things.m2_mvvm_things_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/thing/new"/>
                <class>primary</class>
                <label translate="true">Add New</label>
            </button>
        </buttons>
        <spinner>m2_mvvm_things_columns</spinner>
        <deps>
            <dep>m2_mvvm_things.m2_mvvm_things_data_source</dep>
        </deps>
    </settings>
    <dataSource name="m2_mvvm_things_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">thing_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>M2_MVVM::things</aclResource>
        <dataProvider class="M2\MVVM\Ui\Component\Listing\DataProviders\M2\Mvvm\Things"
                      name="m2_mvvm_things_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>thing_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <paging name="listing_paging"/>
        <filters name="listing_filters"/>
    </listingToolbar>
    <columns name="m2_mvvm_things_columns">
        <selectionsColumn name="ids" sortOrder="10">
            <settings>
                <indexField>thing_id</indexField>
                <resizeEnabled>false</resizeEnabled>
                <resizeDefaultWidth>55</resizeDefaultWidth>
            </settings>
        </selectionsColumn>
        <column name="thing_id" sortOrder="20">
            <settings>
                <filter>textRange</filter>
                <sorting>asc</sorting>
                <label translate="true">ID</label>
            </settings>
        </column>
        <column name="title" sortOrder="105">
            <settings>
                <filter>text</filter>
                <label translate="true">Title</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="M2\MVVM\Ui\Component\Listing\Column\M2mvvmthings\PageActions"
                       sortOrder="200">
            <settings>
                <indexField>thing_id</indexField>
                <resizeEnabled>false</resizeEnabled>
                <resizeDefaultWidth>107</resizeDefaultWidth>
            </settings>
        </actionsColumn>
    </columns>
</listing>
