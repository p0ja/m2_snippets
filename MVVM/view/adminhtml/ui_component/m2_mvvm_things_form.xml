<?xml version="1.0" encoding="UTF-8"?>
<!--
    Changed: rewritten to the <settings> syntax (Magento 2.2+) validated by ui_configuration.xsd; <aclResource>
    restricts the data source to the M2_MVVM::things resource.
-->
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">m2_mvvm_things_form.m2_mvvm_things_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Object Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="M2\MVVM\Block\Adminhtml\Thing\Edit\BackButton"/>
            <button name="delete" class="M2\MVVM\Block\Adminhtml\Thing\Edit\DeleteButton"/>
            <button name="reset" class="M2\MVVM\Block\Adminhtml\Thing\Edit\ResetButton"/>
            <button name="save" class="M2\MVVM\Block\Adminhtml\Thing\Edit\SaveButton"/>
            <button name="save_and_continue" class="M2\MVVM\Block\Adminhtml\Thing\Edit\SaveAndContinueButton"/>
        </buttons>
        <namespace>m2_mvvm_things_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>m2_mvvm_things_form.m2_mvvm_things_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="m2_mvvm_things_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="*/*/save"/>
        </settings>
        <aclResource>M2_MVVM::things</aclResource>
        <dataProvider class="M2\MVVM\Model\Thing\DataProvider" name="m2_mvvm_things_form_data_source">
            <settings>
                <requestFieldName>thing_id</requestFieldName>
                <primaryFieldName>thing_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">Form Data</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
        <field name="thing_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>thing_id</dataScope>
            </settings>
        </field>
        <field name="title" sortOrder="20" formElement="input">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Title</label>
                <dataScope>title</dataScope>
            </settings>
        </field>
    </fieldset>
</form>
