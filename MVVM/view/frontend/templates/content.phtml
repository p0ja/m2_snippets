<?php
/**
 * Changed: reads the Greeting view model passed in layout XML; output is escaped with $escaper, the name comes
 * from the request.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \M2\MVVM\ViewModel\Greeting $viewModel
 */
$viewModel = $block->getData('view_model');
?>
<h1><?= $escaper->escapeHtml(__('content static text')) ?></h1>
<h2><?= $escaper->escapeHtml($viewModel->getMessage()) ?></h2>

<div><?= $escaper->escapeHtml($viewModel->getName()) ?></div>
