<?xml version="1.0" encoding="UTF-8"?>
<!--
    Changed: rewritten from nested <argument>/<item> arrays to the <settings> syntax (Magento 2.2+) validated by
    ui_configuration.xsd, with <dynamicRows> and <actionDelete> elements instead of generic containers.
    <aclResource> restricts the data source to the module's ACL resource. The condition select no longer has the
    default "0", which is not one of its options.
-->
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
   <argument name="data" xsi:type="array">
       <item name="js_config" xsi:type="array">
           <item name="provider" xsi:type="string">dynamic_rows.dynamic_rows_data_source</item>
       </item>
       <item name="label" xsi:type="string" translate="true">Dynamic Rows</item>
       <item name="template" xsi:type="string">templates/form/collapsible</item>
   </argument>
   <settings>
       <buttons>
           <button name="save" class="Vendor\DynamicRows\Block\Adminhtml\DynamicRows\Edit\SaveButton"/>
       </buttons>
       <namespace>dynamic_rows</namespace>
       <dataScope>data</dataScope>
       <deps>
           <dep>dynamic_rows.dynamic_rows_data_source</dep>
       </deps>
   </settings>
   <dataSource name="dynamic_rows_data_source">
       <argument name="data" xsi:type="array">
           <item name="js_config" xsi:type="array">
               <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
           </item>
       </argument>
       <settings>
           <submitUrl path="bss/row/save"/>
       </settings>
       <aclResource>Vendor_DynamicRows::dynamic_rows</aclResource>
       <dataProvider class="Vendor\DynamicRows\Model\DataProvider" name="dynamic_rows_data_source">
           <settings>
               <requestFieldName>scope</requestFieldName>
               <primaryFieldName>row_id</primaryFieldName>
           </settings>
       </dataProvider>
   </dataSource>
   <fieldset name="dynamic_rows_set" sortOrder="10">
       <settings>
           <label translate="true">Dynamic Rows</label>
       </settings>
       <dynamicRows name="dynamic_rows_container">
           <settings>
               <addButtonLabel translate="true">Add Row</addButtonLabel>
               <recordTemplate>record</recordTemplate>
               <deleteProperty>false</deleteProperty>
               <componentType>dynamicRows</componentType>
           </settings>
           <container name="record" component="Magento_Ui/js/dynamic-rows/record">
               <argument name="data" xsi:type="array">
                   <item name="config" xsi:type="array">
                       <item name="isTemplate" xsi:type="boolean">true</item>
                       <item name="is_collection" xsi:type="boolean">true</item>
                       <item name="componentType" xsi:type="string">container</item>
                       <item name="showFallbackReset" xsi:type="boolean">false</item>
                   </item>
               </argument>
               <field name="entity_id" formElement="input">
                   <settings>
                       <dataType>text</dataType>
                       <label translate="true">ID</label>
                       <visible>false</visible>
                       <dataScope>entity_id</dataScope>
                   </settings>
               </field>
               <field name="condition" formElement="select" sortOrder="20">
                   <settings>
                       <dataType>text</dataType>
                       <label translate="true">Condition</label>
                       <dataScope>condition</dataScope>
                   </settings>
                   <formElements>
                       <select>
                           <settings>
                               <options class="Vendor\DynamicRows\Model\Source\Condition"/>
                           </settings>
                       </select>
                   </formElements>
               </field>
               <field name="value" formElement="input">
                   <settings>
                       <dataType>text</dataType>
                       <label translate="true">Value</label>
                       <dataScope>value</dataScope>
                       <visible>false</visible>
                   </settings>
               </field>
               <actionDelete name="action_delete">
                   <settings>
                       <dataType>text</dataType>
                       <label translate="true">Actions</label>
                       <additionalClasses>
                           <class name="data-grid-actions-cell">true</class>
                       </additionalClasses>
                       <componentType>actionDelete</componentType>
                   </settings>
               </actionDelete>
           </container>
       </dynamicRows>
   </fieldset>
</form>
