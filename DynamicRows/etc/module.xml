<?xml version="1.0" encoding="UTF-8"?>
<!--
    Changed: <sequence> lists the modules this one uses: the backend and UI component libraries, the Catalog menu
    it is added to, and Vendor_DynamicCategory, which provides the row model, resource model and collection.
    Vendor_DynamicCategory is not part of this repository.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
   <module name="Vendor_DynamicRows">
       <sequence>
           <module name="Magento_Backend"/>
           <module name="Magento_Ui"/>
           <module name="Magento_Catalog"/>
           <module name="Vendor_DynamicCategory"/>
       </sequence>
   </module>
</config>
